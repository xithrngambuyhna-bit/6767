-- 3. ฟังก์ชันสร้างหน้าย่อย
local function createSubPage(pageName, titleText)
	local page = Instance.new("Frame")
	page.Name = pageName
	page.Size = mainFrame.Size
	page.Position = mainFrame.Position
	page.BackgroundColor3 = mainFrame.BackgroundColor3
	page.BorderSizePixel = 0
	page.Active = true
	page.Draggable = true
	page.Visible = false
	page.Parent = screenGui
	
	local pCorner = Instance.new("UICorner")
	pCorner.CornerRadius = UDim.new(0, 15)
	pCorner.Parent = page

	local pTitle = Instance.new("TextLabel")
	pTitle.Text = titleText
	pTitle.Size = UDim2.new(1, 0, 0, 40)
	pTitle.Position = UDim2.new(0, 0, 0, 10)
	pTitle.TextColor3 = Color3.fromRGB(50, 220, 50)
	pTitle.BackgroundTransparency = 1
	pTitle.Font = Enum.Font.SourceSansBold
	pTitle.TextSize = 24
	pTitle.Parent = page

	local backBtn = Instance.new("TextButton")
	backBtn.Text = "< ย้อนกลับ"
	backBtn.Size = UDim2.new(0, 85, 0, 30)
	backBtn.Position = UDim2.new(0, 10, 0, 10)
	backBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	backBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	backBtn.Font = Enum.Font.SourceSansBold
	backBtn.TextSize = 13
	backBtn.Parent = page
	
	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 8)
	bCorner.Parent = backBtn

	backBtn.MouseButton1Click:Connect(function()
		page.Visible = false
		mainFrame.Visible = true
	end)

	return page
end

